<UserControl x:Class="ScreenTimeTracker.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource Theme.Background}"
        Foreground="{DynamicResource Theme.Text}"
        FontFamily="Segoe UI">
  <Grid Margin="24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="18" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Settings" Style="{StaticResource PageHeading}" />
      <TextBlock Text="Choose how Screen Time looks."
                 FontSize="12"
                 Foreground="{DynamicResource Theme.Muted}"
                 Margin="0,5,0,0" />
    </StackPanel>

    <Border Grid.Row="2"
            Padding="20"
            CornerRadius="18"
            Background="{DynamicResource Theme.Surface}"
            BorderBrush="{DynamicResource Theme.Border}"
            BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold" />
          <TextBlock x:Name="AppearanceText"
                     FontSize="12"
                     Foreground="{DynamicResource Theme.Muted}"
                     Margin="0,5,12,0" />
        </StackPanel>
        <Button x:Name="ThemeButton"
                Grid.Column="1"
                Padding="16,10"
                Background="{DynamicResource Theme.Accent}"
                Foreground="{DynamicResource Theme.OnAccent}"
                BorderBrush="{DynamicResource Theme.Accent}"
                Style="{StaticResource RoundedButton}"
                Click="ToggleTheme_Click" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
