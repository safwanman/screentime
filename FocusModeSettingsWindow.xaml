<Window x:Class="ScreenTimeTracker.FocusModeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Focus mode lists"
        Width="900"
        Height="700"
        MinWidth="760"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6FA"
        FontFamily="Segoe UI"
        Foreground="#182230">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#E9EDF3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <DataTemplate x:Key="FocusAppTemplate">
      <Border Margin="0,0,0,8"
              Padding="12,9"
              CornerRadius="10"
              Background="#FAFBFD"
              BorderBrush="#EEF1F5"
              BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding}"
                     FontSize="13"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Content="Remove"
                  Tag="{Binding}"
                  Click="RemoveApp_Click"
                  Padding="9,5"
                  Background="Transparent"
                  Foreground="#A34848"
                  BorderThickness="0"
                  Cursor="Hand" />
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="FocusWebsiteTemplate">
      <Border Margin="0,0,0,8"
              Padding="12,9"
              CornerRadius="10"
              Background="#FAFBFD"
              BorderBrush="#EEF1F5"
              BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding}"
                     FontSize="13"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Content="Remove"
                  Tag="{Binding}"
                  Click="RemoveWebsite_Click"
                  Padding="9,5"
                  Background="Transparent"
                  Foreground="#A34848"
                  BorderThickness="0"
                  Cursor="Hand" />
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Focus mode lists" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Focus Mode blocks these while it is on; reaching the daily entertainment limit also blocks them for the rest of the day."
                 FontSize="12"
                 Foreground="#7B8798"
                 Margin="0,5,0,0" />
    </StackPanel>

    <Border Grid.Row="1"
            Style="{StaticResource Card}"
            Margin="0,16,0,16">
      <TextBlock Text="The starter list covers common streaming, social, gaming, and music services. App names match either the app's displayed name or its process name; app closures are graceful, so Windows may show an unsaved-work prompt. Website blocking requires the desktop app and Edge extension to be running."
                 FontSize="11"
                 Foreground="#657184"
                 TextWrapping="Wrap" />
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Entertainment apps" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="Enter the displayed app name or executable name."
                       FontSize="11"
                       Foreground="#7B8798"
                       Margin="0,4,0,0" />
          </StackPanel>
          <Grid Grid.Row="1" Margin="0,14,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="AppInput"
                     Padding="10,8"
                     VerticalContentAlignment="Center"
                     Background="#FAFBFD"
                     BorderBrush="#DDE3ED"
                     ToolTip="For example, Spotify or steam.exe" />
            <Button Grid.Column="1"
                    Content="Add app"
                    Click="AddApp_Click"
                    Padding="15,8"
                    Margin="10,0,0,0"
                    Background="#5B6CE1"
                    Foreground="White"
                    BorderBrush="#5B6CE1"
                    FontWeight="SemiBold"
                    Cursor="Hand" />
          </Grid>
          <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="AppsList"
                            ItemTemplate="{StaticResource FocusAppTemplate}" />
            </ScrollViewer>
            <TextBlock x:Name="AppsEmptyText"
                       Text="No focus-blocked apps."
                       FontSize="12"
                       Foreground="#8994A5"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,14,0,0" />
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Entertainment websites" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="Domains include all of their subdomains."
                       FontSize="11"
                       Foreground="#7B8798"
                       Margin="0,4,0,0" />
          </StackPanel>
          <Grid Grid.Row="1" Margin="0,14,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="WebsiteInput"
                     Padding="10,8"
                     VerticalContentAlignment="Center"
                     Background="#FAFBFD"
                     BorderBrush="#DDE3ED"
                     ToolTip="Enter a domain only, such as example.com" />
            <Button Grid.Column="1"
                    Content="Add site"
                    Click="AddWebsite_Click"
                    Padding="15,8"
                    Margin="10,0,0,0"
                    Background="#5B6CE1"
                    Foreground="White"
                    BorderBrush="#5B6CE1"
                    FontWeight="SemiBold"
                    Cursor="Hand" />
          </Grid>
          <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="WebsitesList"
                            ItemTemplate="{StaticResource FocusWebsiteTemplate}" />
            </ScrollViewer>
            <TextBlock x:Name="WebsitesEmptyText"
                       Text="No focus-blocked websites."
                       FontSize="12"
                       Foreground="#8994A5"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,14,0,0" />
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button Content="Cancel"
              Click="Cancel_Click"
              Padding="18,9"
              Margin="0,0,9,0"
              Background="White"
              Foreground="#657184"
              BorderBrush="#E1E6EF" />
      <Button Content="Save focus lists"
              Click="Save_Click"
              Padding="18,9"
              Background="#5B6CE1"
              Foreground="White"
              BorderBrush="#5B6CE1"
              FontWeight="SemiBold" />
    </StackPanel>
  </Grid>
</Window>
