<UserControl x:Class="ScreenTimeTracker.LimitsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource Theme.Background}"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource Theme.Text}">
  <UserControl.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="17" />
    </Style>
    <Style x:Key="TimeField" TargetType="TextBox">
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Theme.Text}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.InputBorder}" />
      <Setter Property="Background" Value="{DynamicResource Theme.Input}" />
    </Style>
    <Style x:Key="ActionButton"
           TargetType="Button"
           BasedOn="{StaticResource RoundedButton}">
      <Setter Property="Padding" Value="18,9" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <DataTemplate x:Key="LimitItemTemplate">
      <Border Padding="10,10"
              Background="Transparent"
              BorderBrush="{DynamicResource Theme.Separator}"
              BorderThickness="0,1,0,0">
      <Grid MinHeight="38">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="62" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Padding="8,4"
                CornerRadius="9"
                Background="{DynamicResource Theme.AccentSurface}"
                VerticalAlignment="Center">
          <TextBlock Text="{Binding Type}"
                     Foreground="{DynamicResource Theme.AccentText}"
                     FontSize="10"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
        </Border>
        <TextBlock Grid.Column="1"
                   Text="{Binding Name}"
                   FontSize="13"
                   FontWeight="Medium"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"
                   Margin="10,0" />
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="8,0">
          <TextBox Width="40"
                   Text="{Binding Hours, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource TimeField}"
                   Tag="Hours"
                   ToolTip="Hours (0–24). Scroll to adjust."
                   PreviewMouseWheel="DurationField_PreviewMouseWheel"
                   PreviewTextInput="DurationField_PreviewTextInput" />
          <TextBlock Text="h" Margin="4,0,7,0" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Muted}" />
          <TextBox Width="40"
                   Text="{Binding Minutes, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource TimeField}"
                   Tag="Minutes"
                   ToolTip="Minutes (0–59). Scroll to adjust."
                   PreviewMouseWheel="DurationField_PreviewMouseWheel"
                   PreviewTextInput="DurationField_PreviewTextInput" />
          <TextBlock Text="m" Margin="4,0,7,0" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Muted}" />
          <TextBox Width="40"
                   Text="{Binding Seconds, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource TimeField}"
                   Tag="Seconds"
                   ToolTip="Seconds (0–59). Scroll to adjust."
                   PreviewMouseWheel="DurationField_PreviewMouseWheel"
                   PreviewTextInput="DurationField_PreviewTextInput" />
          <TextBlock Text="s" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Muted}" />
        </StackPanel>
        <Button Grid.Column="3"
                Content="Remove"
                Tag="{Binding}"
                Click="RemoveLimit_Click"
                Margin="6,0,0,0"
                Style="{StaticResource ListActionButton}" />
      </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="18" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="*" />
      <RowDefinition Height="14" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Entertainment and app limits" Style="{StaticResource PageHeading}" />
      <TextBlock Text="Set a daily entertainment cap and individual app or website limits."
                 FontSize="12"
                 Foreground="{DynamicResource Theme.Muted}"
                 Margin="0,5,0,0" />
    </StackPanel>

    <Border Grid.Row="2" Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Width="30"
                    Height="30"
                    CornerRadius="9"
                    Background="{DynamicResource Theme.AccentSurface}">
              <TextBlock Text="&#x25F7;"
                         Foreground="{DynamicResource Theme.AccentText}"
                         FontSize="16"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Daily entertainment limit"
                       FontWeight="SemiBold"
                       FontSize="14"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0" />
          </StackPanel>
          <TextBlock Text="Usage from apps and websites on your Focus lists. Leave all fields blank to turn this off."
                     FontSize="11"
                     Foreground="{DynamicResource Theme.Muted}"
                     Margin="40,6,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="18,0,0,0">
          <TextBox x:Name="DailyHoursInput"
                   Width="48"
                   Style="{StaticResource TimeField}"
                   Tag="Hours"
                   ToolTip="Hours (0–24). Scroll to adjust."
                   PreviewMouseWheel="DurationField_PreviewMouseWheel"
                   PreviewTextInput="DurationField_PreviewTextInput" />
          <TextBlock Text="h" Margin="5,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Muted}" />
          <TextBox x:Name="DailyMinutesInput"
                   Width="48"
                   Style="{StaticResource TimeField}"
                   Tag="Minutes"
                   ToolTip="Minutes (0–59). Scroll to adjust."
                   PreviewMouseWheel="DurationField_PreviewMouseWheel"
                   PreviewTextInput="DurationField_PreviewTextInput" />
          <TextBlock Text="m" Margin="5,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Muted}" />
          <TextBox x:Name="DailySecondsInput"
                   Width="48"
                   Style="{StaticResource TimeField}"
                   Tag="Seconds"
                   ToolTip="Seconds (0–59). Scroll to adjust."
                   PreviewMouseWheel="DurationField_PreviewMouseWheel"
                   PreviewTextInput="DurationField_PreviewTextInput" />
          <TextBlock Text="s" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Muted}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="4" Style="{StaticResource Card}" Padding="22,20">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="18" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="18" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="App &amp; website limits" Style="{StaticResource PageSectionHeading}" />
            <TextBlock Text="Set daily caps for individual apps and websites."
                       FontSize="11"
                       Foreground="{DynamicResource Theme.Muted}"
                       Margin="0,4,0,0" />
          </StackPanel>
          <Border Grid.Column="1"
                  Padding="10,5"
                  CornerRadius="8"
                  Background="{DynamicResource Theme.SurfaceAlt}"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding ElementName=LimitItems, Path=Items.Count, StringFormat={}{0} limits}"
                       FontSize="11"
                       Foreground="{DynamicResource Theme.MutedStrong}" />
          </Border>
        </Grid>
        <Border Grid.Row="2"
                Padding="16"
                CornerRadius="12"
                Background="{DynamicResource Theme.SurfaceAlt}"
                BorderBrush="{DynamicResource Theme.Border}"
                BorderThickness="1">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="16" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="LimitTypePicker"
                        SelectedIndex="0"
                        SelectionChanged="LimitTypePicker_SelectionChanged"
                        Padding="9,7"
                        Background="{DynamicResource Theme.Input}"
                        Foreground="{DynamicResource Theme.Text}"
                        BorderBrush="{DynamicResource Theme.InputBorder}">
                <ComboBoxItem Content="App" />
                <ComboBoxItem Content="Website" />
              </ComboBox>
              <ComboBox x:Name="AppPicker"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        Padding="9,7"
                        IsTextSearchEnabled="True"
                        DropDownOpened="AppPicker_DropDownOpened"
                        Background="{DynamicResource Theme.Input}"
                        Foreground="{DynamicResource Theme.Text}"
                        BorderBrush="{DynamicResource Theme.InputBorder}"
                        ToolTip="Choose an app that is currently running" />
              <TextBox x:Name="TargetInput"
                       Grid.Column="1"
                       Margin="10,0,0,0"
                       Padding="10,8"
                       VerticalContentAlignment="Center"
                       Background="{DynamicResource Theme.Surface}"
                       Foreground="{DynamicResource Theme.Text}"
                       CaretBrush="{DynamicResource Theme.Text}"
                       BorderBrush="{DynamicResource Theme.InputBorder}"
                       ToolTip="Enter a website domain" />
            </Grid>
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <StackPanel>
                  <TextBlock Text="HOURS" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Subtle}" Margin="0,0,0,5" />
                  <TextBox x:Name="HoursInput"
                           Width="60"
                           Style="{StaticResource TimeField}"
                           Tag="Hours"
                           ToolTip="Hours (0–24). Scroll to adjust."
                           PreviewMouseWheel="DurationField_PreviewMouseWheel"
                           PreviewTextInput="DurationField_PreviewTextInput" />
                </StackPanel>
                <StackPanel Margin="10,0,0,0">
                  <TextBlock Text="MINUTES" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Subtle}" Margin="0,0,0,5" />
                  <TextBox x:Name="MinutesInput"
                           Width="60"
                           Style="{StaticResource TimeField}"
                           Tag="Minutes"
                           ToolTip="Minutes (0–59). Scroll to adjust."
                           PreviewMouseWheel="DurationField_PreviewMouseWheel"
                           PreviewTextInput="DurationField_PreviewTextInput" />
                </StackPanel>
                <StackPanel Margin="10,0,0,0">
                  <TextBlock Text="SECONDS" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Subtle}" Margin="0,0,0,5" />
                  <TextBox x:Name="SecondsInput"
                           Width="60"
                           Style="{StaticResource TimeField}"
                           Tag="Seconds"
                           ToolTip="Seconds (0–59). Scroll to adjust."
                           PreviewMouseWheel="DurationField_PreviewMouseWheel"
                           PreviewTextInput="DurationField_PreviewTextInput" />
                </StackPanel>
              </StackPanel>
              <Button Grid.Column="1"
                      Content="Add limit"
                      Click="AddLimit_Click"
                      Padding="18,9"
                      VerticalAlignment="Bottom"
                      Background="{DynamicResource Theme.Accent}"
                      Foreground="{DynamicResource Theme.OnAccent}"
                      BorderBrush="{DynamicResource Theme.Accent}"
                      BorderThickness="1"
                      FontSize="12"
                      FontWeight="SemiBold"
                      Style="{StaticResource RoundedButton}"
                      Cursor="Hand" />
            </Grid>
          </Grid>
        </Border>
        <TextBlock Grid.Row="4"
                   Text="YOUR LIMITS"
                   FontSize="10"
                   FontWeight="Bold"
                   Foreground="{DynamicResource Theme.Subtle}" />
        <Grid Grid.Row="5" Margin="0,10,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
            <ItemsControl x:Name="LimitItems"
                          ItemTemplate="{StaticResource LimitItemTemplate}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
          <Border x:Name="EmptyText"
                  Padding="20"
                  CornerRadius="12"
                  Background="{DynamicResource Theme.SurfaceAlt}"
                  VerticalAlignment="Top">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="No individual limits yet"
                         FontSize="13"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center" />
              <TextBlock Text="Add an app or website above to get started."
                         FontSize="11"
                         Foreground="{DynamicResource Theme.Subtle}"
                         Margin="0,5,0,0"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
        <TextBlock Grid.Row="6"
                   Text="App closing is a graceful request; unsaved-work prompts may delay it."
                   FontSize="10"
                   Foreground="{DynamicResource Theme.Subtle}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Discard changes"
              Click="Cancel_Click"
              Margin="0,0,9,0"
              Background="{DynamicResource Theme.Surface}"
              Foreground="{DynamicResource Theme.MutedStrong}"
              BorderBrush="{DynamicResource Theme.BorderStrong}"
              Style="{StaticResource ActionButton}" />
      <Button x:Name="SaveLimitsButton"
              Content="Save limits"
              Click="SaveLimits_Click"
              Background="{DynamicResource Theme.Accent}"
              Foreground="{DynamicResource Theme.OnAccent}"
              BorderBrush="{DynamicResource Theme.Accent}"
              Style="{StaticResource ActionButton}" />
    </StackPanel>
    <Border x:Name="CooldownOverlay"
            Grid.Row="0"
            Grid.RowSpan="6"
            Panel.ZIndex="10"
            Background="{DynamicResource Theme.LockOverlay}"
            Visibility="Collapsed">
      <Border Padding="26"
              CornerRadius="16"
              Background="{DynamicResource Theme.Surface}"
              BorderBrush="{DynamicResource Theme.AccentBorder}"
              BorderThickness="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="Limit changes are locked"
                     FontSize="16"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
          <TextBlock x:Name="CooldownText"
                     FontSize="12"
                     Foreground="{DynamicResource Theme.MutedStrong}"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     Margin="0,8,0,0" />
          <Button Content="Unlock limits now"
                  Click="UnlockLimits_Click"
                  Padding="16,8"
                  Margin="0,16,0,0"
                  HorizontalAlignment="Center"
                  Background="{DynamicResource Theme.AccentSurface}"
                  Foreground="{DynamicResource Theme.AccentText}"
                  BorderBrush="{DynamicResource Theme.AccentBorder}"
                  Style="{StaticResource RoundedButton}"
                  FontWeight="SemiBold"
                  Cursor="Hand" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
