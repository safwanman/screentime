<Window x:Class="ScreenTimeTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Time Tracker"
        Width="1120"
        Height="830"
        MinWidth="820"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.Background}"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource Theme.Text}">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style x:Key="SidebarItemButton"
           TargetType="Button"
           BasedOn="{StaticResource RoundedButton}">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.MutedStrong}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Height" Value="42" />
      <Setter Property="Margin" Value="0,0,0,5" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Georgia" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
    </Style>
    <Style x:Key="UsageProgress" TargetType="ProgressBar">
      <Setter Property="Height" Value="5" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Background" Value="{DynamicResource Theme.ProgressBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.Progress}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <DataTemplate x:Key="UsageRowTemplate">
      <Border Padding="10,10"
              Background="Transparent"
              BorderBrush="{DynamicResource Theme.Separator}"
              BorderThickness="0,1,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="5" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="5" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="38" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.RowSpan="3"
                  Width="30"
                  Height="30"
                  CornerRadius="10"
                  Background="{DynamicResource Theme.AccentSurface}"
                  VerticalAlignment="Top">
            <TextBlock Text="{Binding Initial}"
                       Foreground="{DynamicResource Theme.AccentText}"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <TextBlock Grid.Column="1"
                     Text="{Binding Name}"
                     FontSize="13"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="2"
                     Text="{Binding Duration}"
                     FontSize="11"
                     Foreground="{DynamicResource Theme.MutedStrong}"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Row="2"
                     Grid.Column="1"
                     Grid.ColumnSpan="2"
                     Text="{Binding Remaining}"
                     FontSize="10"
                     Foreground="{DynamicResource Theme.Muted}"
                     VerticalAlignment="Center" />
          <ProgressBar Grid.Row="4"
                       Grid.Column="1"
                       Grid.ColumnSpan="2"
                       Value="{Binding Percent}"
                       Style="{StaticResource UsageProgress}" />
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid Margin="20,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="14" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Width="42"
              Height="42"
              Margin="0,0,12,0"
              Padding="0"
              Background="{DynamicResource Theme.Surface}"
              BorderBrush="{DynamicResource Theme.BorderStrong}"
              Style="{StaticResource RoundedButton}"
              Click="OpenNavigation_Click"
              ToolTip="Open navigation"
              AutomationProperties.Name="Open navigation">
        <Path Data="M 1,3 L 19,3 M 1,10 L 19,10 M 1,17 L 19,17"
              Stroke="{DynamicResource Theme.Slate}"
              StrokeThickness="2"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
      </Button>
      <TextBlock Text="Screen time"
                 Grid.Column="1"
                 FontSize="18"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center" />
      <TextBlock x:Name="DateText"
                 Grid.Column="2"
                 FontSize="12"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource Theme.MutedStrong}"
                 VerticalAlignment="Center" />
    </Grid>
    <Grid Grid.Row="2">
      <Grid x:Name="DashboardContent" Margin="14,8,14,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="18" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.35*" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              CornerRadius="20"
              Padding="24,22"
              Background="{DynamicResource Theme.Surface}"
              BorderBrush="{DynamicResource Theme.Border}"
              BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource Theme.Good}" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText"
                       Text="Starting tracker"
                       Margin="9,0,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource Theme.MutedStrong}" />
          </StackPanel>
          <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,22,0,20">
            <TextBlock Text="ENTERTAINMENT TODAY"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Theme.Muted}" />
            <TextBlock x:Name="TotalTimeText"
                       Text="0m"
                       FontFamily="Georgia"
                       FontSize="54"
                       FontWeight="Normal"
                       Foreground="{DynamicResource Theme.Text}"
                       Margin="0,7,0,0" />
            <TextBlock x:Name="TotalTimeDescription"
                       Text="Time from apps and websites on your Focus lists"
                       FontSize="13"
                       Foreground="{DynamicResource Theme.MutedStrong}"
                       Margin="0,2,0,0" />
          </StackPanel>
          <StackPanel Grid.Row="2"
                      Orientation="Horizontal"
                      VerticalAlignment="Center"
                      Margin="0,12,0,0">
            <Button x:Name="FocusModeButton"
                    Content="Turn focus mode on"
                    Click="ToggleFocusMode_Click"
                    Padding="13,8"
                    Background="{DynamicResource Theme.Accent}"
                    Foreground="{DynamicResource Theme.OnAccent}"
                    BorderBrush="{DynamicResource Theme.Accent}"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Style="{StaticResource RoundedButton}"
                    Cursor="Hand" />
          </StackPanel>
        </Grid>
      </Border>

      <StackPanel Grid.Column="2" VerticalAlignment="Center">
        <StackPanel Margin="16,12">
            <TextBlock Text="APPS USED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Muted}" />
            <TextBlock x:Name="AppCountText" Text="0" FontFamily="Georgia" FontSize="32" FontWeight="Normal" Margin="0,9,0,1" />
            <TextBlock Text="with tracked activity today" FontSize="12" Foreground="{DynamicResource Theme.Muted}" />
        </StackPanel>
        <Border Height="1" Background="{DynamicResource Theme.Separator}" Margin="16,0" />
        <StackPanel Margin="16,12">
            <TextBlock Text="SITES VISITED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Muted}" />
            <TextBlock x:Name="SiteCountText" Text="0" FontFamily="Georgia" FontSize="32" FontWeight="Normal" Margin="0,9,0,1" />
            <TextBlock Text="tracked in Microsoft Edge" FontSize="12" Foreground="{DynamicResource Theme.Muted}" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2" Margin="2,0,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Your activity" Style="{StaticResource SectionTitle}" />
    </Grid>

    <Grid Grid.Row="3" Margin="0,13,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Applications" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="  ·  today's time" FontSize="12" Foreground="{DynamicResource Theme.Subtle}" VerticalAlignment="Center" />
          </StackPanel>
          <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
              <ItemsControl x:Name="AppList"
                            ItemTemplate="{StaticResource UsageRowTemplate}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="AppEmptyText"
                       Text="Your app time will appear here as you go."
                       FontSize="12"
                       Foreground="{DynamicResource Theme.Subtle}"
                       TextWrapping="Wrap"
                       Margin="0,9,0,0" />
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Websites" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="  ·  today's time" FontSize="12" Foreground="{DynamicResource Theme.Subtle}" VerticalAlignment="Center" />
          </StackPanel>
          <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
              <ItemsControl x:Name="SiteList"
                            ItemTemplate="{StaticResource UsageRowTemplate}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="SiteEmptyText"
                       Text="Install the Edge companion to see website time."
                       FontSize="12"
                       Foreground="{DynamicResource Theme.Subtle}"
                       TextWrapping="Wrap"
                       Margin="0,9,0,0" />
          </Grid>
        </Grid>
      </Border>
    </Grid>

  </Grid>
      <ContentControl x:Name="PageContent" Visibility="Collapsed" />
    </Grid>
    <Grid x:Name="NavigationOverlay"
          Grid.RowSpan="3"
          Panel.ZIndex="20"
          Visibility="Collapsed">
      <Border x:Name="NavigationScrim"
              Background="{DynamicResource Theme.Overlay}"
              Opacity="0"
              MouseDown="NavigationScrim_MouseDown" />
      <Border x:Name="NavigationDrawer"
              Width="286"
              Margin="0,0,12,0"
              HorizontalAlignment="Left"
              Background="{DynamicResource Theme.Surface}"
              BorderBrush="{DynamicResource Theme.BorderStrong}"
              BorderThickness="0,0,1,0"
              CornerRadius="0,16,16,0">
        <Border.RenderTransform>
          <TranslateTransform x:Name="NavigationDrawerTransform" X="-298" />
        </Border.RenderTransform>
        <Grid Margin="20,22">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Menu"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="Close"
                    Padding="10,6"
                    Background="{DynamicResource Theme.ButtonSurface}"
                    Foreground="{DynamicResource Theme.MutedStrong}"
                    BorderBrush="{DynamicResource Theme.ButtonSurface}"
                    Style="{StaticResource RoundedButton}"
                    Click="CloseNavigation_Click" />
          </Grid>
          <StackPanel Grid.Row="2">
            <Button x:Name="DashboardNavigationButton"
                    Content="Dashboard"
                    Tag="Dashboard"
                    Style="{StaticResource SidebarItemButton}"
                    Click="NavigationItem_Click" />
            <Button x:Name="LimitsNavigationButton"
                    Content="Limits"
                    Tag="Limits"
                    Style="{StaticResource SidebarItemButton}"
                    Click="NavigationItem_Click" />
            <Button x:Name="FocusListsNavigationButton"
                    Content="Focus lists"
                    Tag="Focus lists"
                    Style="{StaticResource SidebarItemButton}"
                    Click="NavigationItem_Click" />
            <Button x:Name="BlockedSitesNavigationButton"
                    Content="Blocked sites"
                    Tag="Blocked sites"
                    Style="{StaticResource SidebarItemButton}"
                    Click="NavigationItem_Click" />
            <Button x:Name="WeeklyTrendsNavigationButton"
                    Content="Weekly trends"
                    Tag="Weekly trends"
                    Style="{StaticResource SidebarItemButton}"
                    Click="NavigationItem_Click" />
            <Button x:Name="DataToolsNavigationButton"
                    Content="Data tools"
                    Tag="Data tools"
                    Style="{StaticResource SidebarItemButton}"
                    Click="NavigationItem_Click" />
            <Button x:Name="SettingsNavigationButton"
                    Content="Settings"
                    Tag="Settings"
                    Style="{StaticResource SidebarItemButton}"
                    Click="NavigationItem_Click" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
  </Grid>
</Window>
