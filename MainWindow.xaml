<Window x:Class="ScreenTimeTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Time Tracker"
        Icon="pack://application:,,,/Laptop%20Clock%20Screen-Time%20Icon.png"
        Width="1120"
        Height="830"
        MinWidth="820"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FA"
        FontFamily="Segoe UI"
        Foreground="#182230">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#E9EDF3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="24" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#182230" />
    </Style>
    <Style x:Key="UsageProgress" TargetType="ProgressBar">
      <Setter Property="Height" Value="5" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Background" Value="#EEF1F6" />
      <Setter Property="Foreground" Value="#6475E5" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <DataTemplate x:Key="UsageRowTemplate">
      <Grid Margin="0,0,0,17">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="2" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="6" />
          <RowDefinition Height="5" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="34" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="72" />
        </Grid.ColumnDefinitions>
        <Border Grid.RowSpan="3"
                Width="30"
                Height="30"
                CornerRadius="9"
                Background="#F0F2FF"
                VerticalAlignment="Top">
          <TextBlock Text="{Binding Initial}"
                     Foreground="#5B6CE1"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>
        <TextBlock Grid.Column="1"
                   Text="{Binding Name}"
                   FontSize="13"
                   FontWeight="Medium"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="2"
                   Text="{Binding Duration}"
                   FontSize="12"
                   Foreground="#657184"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Row="2"
                   Grid.Column="1"
                   Grid.ColumnSpan="2"
                   Text="{Binding Remaining}"
                   FontSize="10"
                   Foreground="#6475C5"
                   VerticalAlignment="Center" />
        <ProgressBar Grid.Row="4"
                     Grid.Column="1"
                     Grid.ColumnSpan="2"
                     Value="{Binding Percent}"
                     Style="{StaticResource UsageProgress}" />
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="38,28,38,26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="24" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="22" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="54" Height="38" CornerRadius="12" Background="#EEF3FC">
          <Image Source="/Laptop%20Clock%20Screen-Time%20Icon.png"
                 Stretch="Uniform" />
        </Border>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="SCREEN TIME" FontSize="11" FontWeight="Bold" />
          <TextBlock Text="Your day, in perspective." FontSize="13" Foreground="#7B8798" Margin="0,2,0,0" />
        </StackPanel>
      </StackPanel>
      <Button Grid.Column="1"
              Content="Set limits"
              Click="OpenLimits_Click"
              Padding="14,8"
              Margin="0,0,10,0"
              Background="#F0F2FF"
              Foreground="#5363D2"
              BorderBrush="#E0E4FF"
              BorderThickness="1"
              FontSize="12"
              FontWeight="SemiBold"
              Cursor="Hand"
              VerticalAlignment="Center" />
      <Border Grid.Column="2"
              Padding="12,8"
              CornerRadius="12"
              Background="White"
              BorderBrush="#E9EDF3"
              BorderThickness="1"
              VerticalAlignment="Center">
        <TextBlock x:Name="DateText" FontSize="12" FontWeight="SemiBold" Foreground="#657184" />
      </Border>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.35*" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" CornerRadius="18" Padding="28,25" Background="#202B47">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="#73D6B0" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText"
                       Text="Starting tracker"
                       Margin="9,0,0,0"
                       FontSize="12"
                       Foreground="#D9E1F2" />
          </StackPanel>
          <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,22,0,20">
            <TextBlock Text="SCREEN TIME TODAY"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#AAB6D0" />
            <TextBlock x:Name="TotalTimeText"
                       Text="0m"
                       FontSize="54"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Margin="0,7,0,0" />
            <TextBlock x:Name="TotalTimeDescription"
                       Text="Time across your active apps"
                       FontSize="13"
                       Foreground="#B8C2D8"
                       Margin="0,2,0,0" />
          </StackPanel>
          <TextBlock Grid.Row="2"
                     Text="Only your active window is counted. Tracking pauses after five minutes away."
                     FontSize="11"
                     Foreground="#AAB6D0"
                     TextWrapping="Wrap" />
        </Grid>
      </Border>

      <StackPanel Grid.Column="2">
        <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="APPS USED" FontSize="10" FontWeight="Bold" Foreground="#7B8798" />
            <TextBlock x:Name="AppCountText" Text="0" FontSize="32" FontWeight="SemiBold" Margin="0,9,0,1" />
            <TextBlock Text="with tracked activity today" FontSize="12" Foreground="#7B8798" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="22">
          <StackPanel>
            <TextBlock Text="SITES VISITED" FontSize="10" FontWeight="Bold" Foreground="#7B8798" />
            <TextBlock x:Name="SiteCountText" Text="0" FontSize="32" FontWeight="SemiBold" Margin="0,9,0,1" />
            <TextBlock Text="tracked in Microsoft Edge" FontSize="12" Foreground="#7B8798" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="4" Margin="2,0,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Your activity" Style="{StaticResource SectionTitle}" />
      <TextBlock Grid.Column="1"
                 Text="Updates live · saved on this device"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center"
                 FontSize="11"
                 Foreground="#8994A5" />
    </Grid>

    <Grid Grid.Row="5" Margin="0,13,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Applications" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="  ·  today's time" FontSize="12" Foreground="#8994A5" VerticalAlignment="Center" />
          </StackPanel>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
              <ItemsControl x:Name="AppList" ItemTemplate="{StaticResource UsageRowTemplate}" />
              <TextBlock x:Name="AppEmptyText"
                         Text="Your app time will appear here as you go."
                         FontSize="12"
                         Foreground="#8994A5"
                         TextWrapping="Wrap"
                         Margin="0,9,0,0" />
            </Grid>
          </ScrollViewer>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Websites" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="  ·  today's time" FontSize="12" Foreground="#8994A5" VerticalAlignment="Center" />
          </StackPanel>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
              <ItemsControl x:Name="SiteList" ItemTemplate="{StaticResource UsageRowTemplate}" />
              <TextBlock x:Name="SiteEmptyText"
                         Text="Install the Edge companion to see website time."
                         FontSize="12"
                         Foreground="#8994A5"
                         TextWrapping="Wrap"
                         Margin="0,9,0,0" />
            </Grid>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="6"
            Padding="14,11"
            CornerRadius="12"
            Background="#EDF0F8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="PRIVATE BY DESIGN"
                   FontSize="9"
                   FontWeight="Bold"
                   Foreground="#5B6CE1"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="App names and website domains stay on this PC. No page content or full URLs are saved."
                   FontSize="10"
                   Foreground="#657184"
                   Margin="14,0,10,0"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2"
                   Text="Edge extension: edge-extension"
                   FontSize="9"
                   Foreground="#8994A5"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
