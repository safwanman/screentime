<UserControl x:Class="ScreenTimeTracker.WeeklyTrendsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource Theme.Background}"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource Theme.Text}">
  <UserControl.Resources>
    <Style x:Key="TrendBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="6" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Background" Value="{DynamicResource Theme.ProgressBackground}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <DataTemplate x:Key="TrendDayTemplate">
      <Border Margin="0,0,0,9"
              Padding="14,12"
              CornerRadius="14"
              Background="{DynamicResource Theme.SurfaceAlt}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="6" />
            <RowDefinition Height="4" />
            <RowDefinition Height="6" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Date}"
                     FontSize="12"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Text="{Binding AppTime}"
                     FontSize="11"
                     Foreground="{DynamicResource Theme.MutedStrong}"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="2"
                     Text="{Binding WebsiteTime}"
                     FontSize="11"
                     Foreground="{DynamicResource Theme.MutedStrong}"
                     VerticalAlignment="Center" />
          <ProgressBar Grid.Row="2"
                       Grid.Column="1"
                       Grid.ColumnSpan="2"
                       Value="{Binding AppPercent}"
                       Foreground="{DynamicResource Theme.Progress}"
                       Style="{StaticResource TrendBar}" />
          <ProgressBar Grid.Row="4"
                       Grid.Column="1"
                       Grid.ColumnSpan="2"
                       Value="{Binding WebsitePercent}"
                       Foreground="{DynamicResource Theme.Website}"
                       Style="{StaticResource TrendBar}" />
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="18" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="14" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="14" />
      <RowDefinition Height="*" />
      <RowDefinition Height="14" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Weekly trends" FontSize="23" FontWeight="SemiBold" />
      <TextBlock Text="Last 7 calendar days, including today, compared with the previous 7 days."
                 FontSize="12"
                 Foreground="{DynamicResource Theme.Muted}"
                 Margin="0,5,0,0" />
    </StackPanel>

    <Border Grid.Row="2"
            Padding="18"
            CornerRadius="16"
            Background="{DynamicResource Theme.Surface}"
            BorderBrush="{DynamicResource Theme.Border}"
            BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="1" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="LAST 7 DAYS · APP TIME"
                     FontSize="9"
                     FontWeight="Bold"
                     Foreground="{DynamicResource Theme.Muted}" />
          <TextBlock x:Name="CurrentTotalText"
                     FontSize="25"
                     FontWeight="SemiBold"
                     Margin="0,5,0,0" />
          <TextBlock x:Name="ChangeText"
                     FontSize="11"
                     Foreground="{DynamicResource Theme.AccentText}"
                     Margin="0,3,0,0" />
        </StackPanel>
        <Border Grid.Column="1" Background="{DynamicResource Theme.Border}" />
        <StackPanel Grid.Column="2" Margin="18,0,0,0">
          <TextBlock Text="PREVIOUS 7 DAYS · APP TIME"
                     FontSize="9"
                     FontWeight="Bold"
                     Foreground="{DynamicResource Theme.Muted}" />
          <TextBlock x:Name="PreviousTotalText"
                     FontSize="25"
                     FontWeight="SemiBold"
                     Margin="0,5,0,0" />
          <TextBlock Text="Website time is shown separately below."
                     FontSize="11"
                     Foreground="{DynamicResource Theme.Muted}"
                     Margin="0,3,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <TextBlock x:Name="PeriodText"
               Grid.Row="4"
               FontSize="11"
               Foreground="{DynamicResource Theme.Muted}" />

    <Border Grid.Row="6"
            Padding="20,18"
            CornerRadius="16"
            Background="{DynamicResource Theme.Surface}"
            BorderBrush="{DynamicResource Theme.Border}"
            BorderThickness="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="TrendList" ItemTemplate="{StaticResource TrendDayTemplate}" />
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="8"
               Text="Website time is included in Microsoft Edge app time; it is a subset and is not added twice."
               FontSize="10"
               Foreground="{DynamicResource Theme.Muted}"
               TextWrapping="Wrap" />
  </Grid>
</UserControl>
