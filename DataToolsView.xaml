<UserControl x:Class="ScreenTimeTracker.DataToolsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource Theme.Background}"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource Theme.Text}">
  <UserControl.Resources>
    <Style x:Key="ToolButton"
           TargetType="Button"
           BasedOn="{StaticResource RoundedButton}">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="16,13" />
      <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="10" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="10" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Screen Time data" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Export, back up, or clear the data stored on this PC."
                 FontSize="12"
                 Foreground="{DynamicResource Theme.Muted}"
                 Margin="0,5,0,0" />
    </StackPanel>

    <Button Grid.Row="2"
            Content="Export usage history as CSV"
            Click="ExportHistory_Click"
            Style="{StaticResource ToolButton}" />
    <Button Grid.Row="4"
            Content="Back up history, limits, and lockout as JSON"
            Click="BackupData_Click"
            Style="{StaticResource ToolButton}" />
    <Button Grid.Row="6"
            Content="Clear all history, limits, and lockout"
            Click="ClearAllData_Click"
            Foreground="{DynamicResource Theme.Danger}"
            Style="{StaticResource ToolButton}" />

    <TextBlock Grid.Row="7"
               Text="Clearing all data cannot be undone. Create a JSON backup first if you may want to restore it later."
               FontSize="11"
               Foreground="{DynamicResource Theme.Muted}"
               TextWrapping="Wrap"
               VerticalAlignment="Center"
               Margin="2,12" />

  </Grid>
</UserControl>