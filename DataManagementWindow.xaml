<Window x:Class="ScreenTimeTracker.DataManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Time data tools"
        Width="520"
        Height="490"
        MinWidth="460"
        MinHeight="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6FA"
        FontFamily="Segoe UI"
        Foreground="#182230">
  <Window.Resources>
    <Style x:Key="ToolButton" TargetType="Button">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="16,13" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#E3E8F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Window.Resources>

  <Grid Margin="28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="10" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="10" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Screen Time data" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Export, back up, or clear the data stored on this PC."
                 FontSize="12"
                 Foreground="#7B8798"
                 Margin="0,5,0,0" />
    </StackPanel>

    <Button Grid.Row="2"
            Content="Export usage history as CSV"
            Click="ExportHistory_Click"
            Style="{StaticResource ToolButton}" />
    <Button Grid.Row="4"
            Content="Back up history, limits, and lockout as JSON"
            Click="BackupData_Click"
            Style="{StaticResource ToolButton}" />
    <Button Grid.Row="6"
            Content="Clear all history, limits, and lockout"
            Click="ClearAllData_Click"
            Foreground="#A34848"
            Style="{StaticResource ToolButton}" />

    <TextBlock Grid.Row="7"
               Text="Clearing all data cannot be undone. Create a JSON backup first if you may want to restore it later."
               FontSize="11"
               Foreground="#7B8798"
               TextWrapping="Wrap"
               VerticalAlignment="Center"
               Margin="2,12" />

    <Button Grid.Row="8"
            Content="Close"
            Click="Close_Click"
            Padding="18,9"
            HorizontalAlignment="Right"
            Background="#F0F2FF"
            Foreground="#5363D2"
            BorderBrush="#E0E4FF"
            FontWeight="SemiBold"
            Cursor="Hand" />
  </Grid>
</Window>