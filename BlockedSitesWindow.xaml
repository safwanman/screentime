<Window x:Class="ScreenTimeTracker.BlockedSitesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blocked websites"
        Width="640"
        Height="700"
        MinWidth="560"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6FA"
        FontFamily="Segoe UI"
        Foreground="#182230">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#E9EDF3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <DataTemplate x:Key="BlockedSiteTemplate">
      <Border Margin="0,0,0,8"
              Padding="12,9"
              CornerRadius="10"
              Background="#FAFBFD"
              BorderBrush="#EEF1F5"
              BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding}"
                     FontSize="13"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Content="Remove"
                  Tag="{Binding}"
                  Click="RemoveSite_Click"
                  Padding="9,5"
                  Background="Transparent"
                  Foreground="#A34848"
                  BorderThickness="0"
                  Cursor="Hand" />
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="14" />
      <RowDefinition Height="*" />
      <RowDefinition Height="14" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Blocked websites" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Choose websites that should always be blocked in Edge."
                 FontSize="12"
                 Foreground="#7B8798"
                 Margin="0,5,0,0" />
    </StackPanel>

    <Border Grid.Row="2" Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Short-form content is automatically blocked"
                   FontSize="14"
                   FontWeight="SemiBold" />
        <TextBlock Text="TikTok (entire site), YouTube Shorts, Instagram Reels, Facebook Reels, and Snapchat Spotlight."
                   FontSize="11"
                   Foreground="#657184"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0" />
        <TextBlock Text="Only the site domain and a short-form yes/no flag are sent to the tracker; page paths stay in Edge."
                   FontSize="10"
                   Foreground="#8994A5"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0" />
      </StackPanel>
    </Border>

    <Border Grid.Row="4" Style="{StaticResource Card}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="14" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="12" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="Your blocked domains" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Text="A blocked domain also blocks all of its subdomains."
                     FontSize="11"
                     Foreground="#7B8798"
                     Margin="0,4,0,0" />
        </StackPanel>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="DomainInput"
                   Padding="10,8"
                   VerticalContentAlignment="Center"
                   Background="#FAFBFD"
                   BorderBrush="#DDE3ED"
                   ToolTip="Enter a domain only, such as example.com" />
          <Button Grid.Column="1"
                  Content="Add domain"
                  Click="AddSite_Click"
                  Padding="15,8"
                  Margin="10,0,0,0"
                  Background="#5B6CE1"
                  Foreground="White"
                  BorderBrush="#5B6CE1"
                  FontWeight="SemiBold"
                  Cursor="Hand" />
        </Grid>
        <Grid Grid.Row="4">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="BlockedSitesList"
                          ItemTemplate="{StaticResource BlockedSiteTemplate}" />
          </ScrollViewer>
          <TextBlock x:Name="EmptyText"
                     Text="No custom blocked domains yet."
                     FontSize="12"
                     Foreground="#8994A5"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Top"
                     Margin="0,14,0,0" />
        </Grid>
        <TextBlock Grid.Row="5"
                   Text="Custom blocks and automatic short-form blocks require the desktop app and Edge extension to be running."
                   FontSize="10"
                   Foreground="#8994A5"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="6"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button Content="Cancel"
              Click="Cancel_Click"
              Padding="18,9"
              Margin="0,0,9,0"
              Background="White"
              Foreground="#657184"
              BorderBrush="#E1E6EF" />
      <Button Content="Save blocked sites"
              Click="Save_Click"
              Padding="18,9"
              Background="#5B6CE1"
              Foreground="White"
              BorderBrush="#5B6CE1"
              FontWeight="SemiBold" />
    </StackPanel>
  </Grid>
</Window>
