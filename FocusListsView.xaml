<UserControl x:Class="ScreenTimeTracker.FocusListsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource Theme.Background}"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource Theme.Text}">
  <UserControl.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <DataTemplate x:Key="FocusAppTemplate">
      <Border Padding="10,10"
              Background="Transparent"
              BorderBrush="{DynamicResource Theme.Separator}"
              BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding}"
                     FontSize="13"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Content="Remove"
                  Tag="{Binding}"
                  Click="RemoveApp_Click"
                  Style="{StaticResource ListActionButton}" />
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="FocusWebsiteTemplate">
      <Border Padding="10,10"
              Background="Transparent"
              BorderBrush="{DynamicResource Theme.Separator}"
              BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding}"
                     FontSize="13"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Content="Remove"
                  Tag="{Binding}"
                  Click="RemoveWebsite_Click"
                  Style="{StaticResource ListActionButton}" />
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Focus mode lists" Style="{StaticResource PageHeading}" />
      <TextBlock Text="Focus Mode blocks these while it is on; reaching the daily entertainment limit also blocks them for the rest of the day."
                 FontSize="12"
                 Foreground="{DynamicResource Theme.Muted}"
                 Margin="0,5,0,0" />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Entertainment apps" Style="{StaticResource PageSectionHeading}" />
            <TextBlock Text="Enter the displayed app name or executable name."
                       FontSize="11"
                       Foreground="{DynamicResource Theme.Muted}"
                       Margin="0,4,0,0" />
          </StackPanel>
          <Grid Grid.Row="1" Margin="0,14,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="AppInput"
                     Padding="10,8"
                     VerticalContentAlignment="Center"
                     Background="{DynamicResource Theme.Input}"
                     Foreground="{DynamicResource Theme.Text}"
                     CaretBrush="{DynamicResource Theme.Text}"
                     BorderBrush="{DynamicResource Theme.InputBorder}"
                     ToolTip="For example, Spotify or steam.exe" />
            <Button Grid.Column="1"
                    Content="Add app"
                    Click="AddApp_Click"
                    Padding="15,8"
                    Margin="10,0,0,0"
                    Background="{DynamicResource Theme.Accent}"
                    Foreground="{DynamicResource Theme.OnAccent}"
                    BorderBrush="{DynamicResource Theme.Accent}"
                    Style="{StaticResource RoundedButton}"
                    FontWeight="SemiBold"
                    Cursor="Hand" />
          </Grid>
          <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
              <ItemsControl x:Name="AppsList"
                            ItemTemplate="{StaticResource FocusAppTemplate}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="AppsEmptyText"
                       Text="No focus-blocked apps."
                       FontSize="12"
                       Foreground="{DynamicResource Theme.Subtle}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,14,0,0" />
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Entertainment websites" Style="{StaticResource PageSectionHeading}" />
            <TextBlock Text="Domains include all of their subdomains."
                       FontSize="11"
                       Foreground="{DynamicResource Theme.Muted}"
                       Margin="0,4,0,0" />
          </StackPanel>
          <Grid Grid.Row="1" Margin="0,14,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="WebsiteInput"
                     Padding="10,8"
                     VerticalContentAlignment="Center"
                     Background="{DynamicResource Theme.Input}"
                     Foreground="{DynamicResource Theme.Text}"
                     CaretBrush="{DynamicResource Theme.Text}"
                     BorderBrush="{DynamicResource Theme.InputBorder}"
                     ToolTip="Enter a domain only, such as example.com" />
            <Button Grid.Column="1"
                    Content="Add site"
                    Click="AddWebsite_Click"
                    Padding="15,8"
                    Margin="10,0,0,0"
                    Background="{DynamicResource Theme.Accent}"
                    Foreground="{DynamicResource Theme.OnAccent}"
                    BorderBrush="{DynamicResource Theme.Accent}"
                    Style="{StaticResource RoundedButton}"
                    FontWeight="SemiBold"
                    Cursor="Hand" />
          </Grid>
          <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
              <ItemsControl x:Name="WebsitesList"
                            ItemTemplate="{StaticResource FocusWebsiteTemplate}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="WebsitesEmptyText"
                       Text="No focus-blocked websites."
                       FontSize="12"
                       Foreground="{DynamicResource Theme.Subtle}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,14,0,0" />
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button Content="Discard changes"
              Click="Cancel_Click"
              Padding="18,9"
              Margin="0,0,9,0"
              Background="{DynamicResource Theme.Surface}"
              Foreground="{DynamicResource Theme.MutedStrong}"
              BorderBrush="{DynamicResource Theme.BorderStrong}"
              Style="{StaticResource RoundedButton}" />
      <Button Content="Save focus lists"
              Click="Save_Click"
              Padding="18,9"
              Background="{DynamicResource Theme.Accent}"
              Foreground="{DynamicResource Theme.OnAccent}"
              BorderBrush="{DynamicResource Theme.Accent}"
              Style="{StaticResource RoundedButton}"
              FontWeight="SemiBold" />
    </StackPanel>
  </Grid>
</UserControl>
