<UserControl x:Class="ScreenTimeTracker.BlockedSitesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource Theme.Background}"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource Theme.Text}">
  <UserControl.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <DataTemplate x:Key="BlockedSiteTemplate">
      <Border Margin="0,0,0,8"
              Padding="13,10"
              CornerRadius="14"
              Background="{DynamicResource Theme.SurfaceAlt}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding}"
                     FontSize="13"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Content="Remove"
                  Tag="{Binding}"
                  Click="RemoveSite_Click"
                  Style="{StaticResource ListActionButton}" />
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="14" />
      <RowDefinition Height="*" />
      <RowDefinition Height="14" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Blocked websites" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Choose websites that should always be blocked in Edge."
                 FontSize="12"
                 Foreground="{DynamicResource Theme.Muted}"
                 Margin="0,5,0,0" />
    </StackPanel>

    <Border Grid.Row="2" Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Short-form content is automatically blocked"
                   FontSize="14"
                   FontWeight="SemiBold" />
        <TextBlock Text="TikTok (entire site), YouTube Shorts, Instagram Reels, Facebook Reels, and Snapchat Spotlight."
                   FontSize="11"
                   Foreground="{DynamicResource Theme.MutedStrong}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0" />
      </StackPanel>
    </Border>

    <Border Grid.Row="4" Style="{StaticResource Card}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="14" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="12" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="Your blocked domains" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Text="A blocked domain also blocks all of its subdomains."
                     FontSize="11"
                     Foreground="{DynamicResource Theme.Muted}"
                     Margin="0,4,0,0" />
        </StackPanel>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="DomainInput"
                   Padding="10,8"
                   VerticalContentAlignment="Center"
                   Background="{DynamicResource Theme.Input}"
                   Foreground="{DynamicResource Theme.Text}"
                   CaretBrush="{DynamicResource Theme.Text}"
                   BorderBrush="{DynamicResource Theme.InputBorder}"
                   ToolTip="Enter a domain only, such as example.com" />
          <Button Grid.Column="1"
                  Content="Add domain"
                  Click="AddSite_Click"
                  Padding="15,8"
                  Margin="10,0,0,0"
                  Background="{DynamicResource Theme.Accent}"
                  Foreground="{DynamicResource Theme.OnAccent}"
                  BorderBrush="{DynamicResource Theme.Accent}"
                  Style="{StaticResource RoundedButton}"
                  FontWeight="SemiBold"
                  Cursor="Hand" />
        </Grid>
        <Grid Grid.Row="4">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="BlockedSitesList"
                          ItemTemplate="{StaticResource BlockedSiteTemplate}" />
          </ScrollViewer>
          <TextBlock x:Name="EmptyText"
                     Text="No custom blocked domains yet."
                     FontSize="12"
                     Foreground="{DynamicResource Theme.Subtle}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Top"
                     Margin="0,14,0,0" />
        </Grid>
        <TextBlock Grid.Row="5"
                   Text="Custom blocks and automatic short-form blocks require the desktop app and Edge extension to be running."
                   FontSize="10"
                   Foreground="{DynamicResource Theme.Subtle}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="6"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button Content="Discard changes"
              Click="Cancel_Click"
              Padding="18,9"
              Margin="0,0,9,0"
              Background="{DynamicResource Theme.Surface}"
              Foreground="{DynamicResource Theme.MutedStrong}"
              BorderBrush="{DynamicResource Theme.BorderStrong}"
              Style="{StaticResource RoundedButton}" />
      <Button Content="Save blocked sites"
              Click="Save_Click"
              Padding="18,9"
              Background="{DynamicResource Theme.Accent}"
              Foreground="{DynamicResource Theme.OnAccent}"
              BorderBrush="{DynamicResource Theme.Accent}"
              Style="{StaticResource RoundedButton}"
              FontWeight="SemiBold" />
    </StackPanel>
  </Grid>
</UserControl>
