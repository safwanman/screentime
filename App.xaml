<Application x:Class="ScreenTimeTracker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#182230" />
    <SolidColorBrush x:Key="MutedInk" Color="#7B8798" />
    <SolidColorBrush x:Key="Accent" Color="#5B6CE1" />
    <SolidColorBrush x:Key="CardBorder" Color="#E9EDF3" />
  </Application.Resources>
</Application>
