<Window x:Class="ScreenTimeTracker.LimitsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Time Limits"
        Width="760"
        Height="800"
        MinWidth="680"
        MinHeight="660"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6FA"
        FontFamily="Segoe UI"
        Foreground="#182230">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#E9EDF3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style x:Key="TimeField" TargetType="TextBox">
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="BorderBrush" Value="#DDE3ED" />
      <Setter Property="Background" Value="#FAFBFD" />
    </Style>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Padding" Value="18,9" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <DataTemplate x:Key="LimitItemTemplate">
      <Border Margin="0,0,0,8"
              Padding="12,10"
              CornerRadius="10"
              Background="#FAFBFD"
              BorderBrush="#EEF1F5"
              BorderThickness="1">
      <Grid MinHeight="38">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="62" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Padding="8,4"
                CornerRadius="7"
                Background="#F0F2FF"
                VerticalAlignment="Center">
          <TextBlock Text="{Binding Type}"
                     Foreground="#5969D5"
                     FontSize="10"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
        </Border>
        <TextBlock Grid.Column="1"
                   Text="{Binding Name}"
                   FontSize="13"
                   FontWeight="Medium"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"
                   Margin="10,0" />
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="8,0">
          <TextBox Width="40"
                   Text="{Binding Hours, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource TimeField}"
                   Tag="Hours"
                   ToolTip="Hours (0–24). Scroll to adjust."
                   PreviewMouseWheel="DurationField_PreviewMouseWheel"
                   PreviewTextInput="DurationField_PreviewTextInput" />
          <TextBlock Text="h" Margin="4,0,7,0" VerticalAlignment="Center" Foreground="#7B8798" />
          <TextBox Width="40"
                   Text="{Binding Minutes, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource TimeField}"
                   Tag="Minutes"
                   ToolTip="Minutes (0–59). Scroll to adjust."
                   PreviewMouseWheel="DurationField_PreviewMouseWheel"
                   PreviewTextInput="DurationField_PreviewTextInput" />
          <TextBlock Text="m" Margin="4,0,7,0" VerticalAlignment="Center" Foreground="#7B8798" />
          <TextBox Width="40"
                   Text="{Binding Seconds, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource TimeField}"
                   Tag="Seconds"
                   ToolTip="Seconds (0–59). Scroll to adjust."
                   PreviewMouseWheel="DurationField_PreviewMouseWheel"
                   PreviewTextInput="DurationField_PreviewTextInput" />
          <TextBlock Text="s" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="#7B8798" />
        </StackPanel>
        <Button Grid.Column="3"
                Content="Remove"
                Tag="{Binding}"
                Click="RemoveLimit_Click"
                Padding="9,6"
                Margin="6,0,0,0"
                Background="Transparent"
                Foreground="#A34848"
                BorderThickness="0"
                FontSize="11"
                Cursor="Hand" />
      </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="32,26,32,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="18" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="*" />
      <RowDefinition Height="14" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="46" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Width="42"
              Height="42"
              CornerRadius="13"
              Background="#F0F2FF">
        <TextBlock Text="ST"
                   Foreground="#5969D5"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
        <TextBlock Text="Entertainment and app limits" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="Set a daily entertainment cap and individual app or website limits."
                 FontSize="12"
                 Foreground="#7B8798"
                 Margin="0,5,0,0" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="2" Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Width="30"
                    Height="30"
                    CornerRadius="9"
                    Background="#F0F2FF">
              <TextBlock Text="&#x25F7;"
                         Foreground="#5969D5"
                         FontSize="16"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Daily entertainment limit"
                       FontWeight="SemiBold"
                       FontSize="14"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0" />
          </StackPanel>
          <TextBlock Text="Usage from apps and websites on your Focus lists. Leave all fields blank to turn this off."
                     FontSize="11"
                     Foreground="#7B8798"
                     Margin="40,6,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="18,0,0,0">
          <TextBox x:Name="DailyHoursInput"
                   Width="48"
                   Style="{StaticResource TimeField}"
                   Tag="Hours"
                   ToolTip="Hours (0–24). Scroll to adjust."
                   PreviewMouseWheel="DurationField_PreviewMouseWheel"
                   PreviewTextInput="DurationField_PreviewTextInput" />
          <TextBlock Text="h" Margin="5,0,12,0" VerticalAlignment="Center" Foreground="#7B8798" />
          <TextBox x:Name="DailyMinutesInput"
                   Width="48"
                   Style="{StaticResource TimeField}"
                   Tag="Minutes"
                   ToolTip="Minutes (0–59). Scroll to adjust."
                   PreviewMouseWheel="DurationField_PreviewMouseWheel"
                   PreviewTextInput="DurationField_PreviewTextInput" />
          <TextBlock Text="m" Margin="5,0,12,0" VerticalAlignment="Center" Foreground="#7B8798" />
          <TextBox x:Name="DailySecondsInput"
                   Width="48"
                   Style="{StaticResource TimeField}"
                   Tag="Seconds"
                   ToolTip="Seconds (0–59). Scroll to adjust."
                   PreviewMouseWheel="DurationField_PreviewMouseWheel"
                   PreviewTextInput="DurationField_PreviewTextInput" />
          <TextBlock Text="s" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#7B8798" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="4" Style="{StaticResource Card}" Padding="22,20">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="18" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="18" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="App &amp; website limits" FontWeight="SemiBold" FontSize="16" />
            <TextBlock Text="Set daily caps for individual apps and websites."
                       FontSize="11"
                       Foreground="#7B8798"
                       Margin="0,4,0,0" />
          </StackPanel>
          <Border Grid.Column="1"
                  Padding="10,5"
                  CornerRadius="8"
                  Background="#F4F6FA"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding ElementName=LimitItems, Path=Items.Count, StringFormat={}{0} limits}"
                       FontSize="11"
                       Foreground="#657184" />
          </Border>
        </Grid>
        <Border Grid.Row="2"
                Padding="16"
                CornerRadius="12"
                Background="#F8F9FC"
                BorderBrush="#EEF1F5"
                BorderThickness="1">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="16" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="LimitTypePicker"
                        SelectedIndex="0"
                        SelectionChanged="LimitTypePicker_SelectionChanged"
                        Padding="9,7">
                <ComboBoxItem Content="App" />
                <ComboBoxItem Content="Website" />
              </ComboBox>
              <ComboBox x:Name="AppPicker"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        Padding="9,7"
                        IsTextSearchEnabled="True"
                        DropDownOpened="AppPicker_DropDownOpened"
                        ToolTip="Choose an app that is currently running" />
              <TextBox x:Name="TargetInput"
                       Grid.Column="1"
                       Margin="10,0,0,0"
                       Padding="10,8"
                       VerticalContentAlignment="Center"
                       Background="White"
                       BorderBrush="#DDE3ED"
                       ToolTip="Enter a website domain" />
            </Grid>
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <StackPanel>
                  <TextBlock Text="HOURS" FontSize="9" FontWeight="SemiBold" Foreground="#8994A5" Margin="0,0,0,5" />
                  <TextBox x:Name="HoursInput"
                           Width="60"
                           Style="{StaticResource TimeField}"
                           Tag="Hours"
                           ToolTip="Hours (0–24). Scroll to adjust."
                           PreviewMouseWheel="DurationField_PreviewMouseWheel"
                           PreviewTextInput="DurationField_PreviewTextInput" />
                </StackPanel>
                <StackPanel Margin="10,0,0,0">
                  <TextBlock Text="MINUTES" FontSize="9" FontWeight="SemiBold" Foreground="#8994A5" Margin="0,0,0,5" />
                  <TextBox x:Name="MinutesInput"
                           Width="60"
                           Style="{StaticResource TimeField}"
                           Tag="Minutes"
                           ToolTip="Minutes (0–59). Scroll to adjust."
                           PreviewMouseWheel="DurationField_PreviewMouseWheel"
                           PreviewTextInput="DurationField_PreviewTextInput" />
                </StackPanel>
                <StackPanel Margin="10,0,0,0">
                  <TextBlock Text="SECONDS" FontSize="9" FontWeight="SemiBold" Foreground="#8994A5" Margin="0,0,0,5" />
                  <TextBox x:Name="SecondsInput"
                           Width="60"
                           Style="{StaticResource TimeField}"
                           Tag="Seconds"
                           ToolTip="Seconds (0–59). Scroll to adjust."
                           PreviewMouseWheel="DurationField_PreviewMouseWheel"
                           PreviewTextInput="DurationField_PreviewTextInput" />
                </StackPanel>
              </StackPanel>
              <Button Grid.Column="1"
                      Content="Add limit"
                      Click="AddLimit_Click"
                      Padding="18,9"
                      VerticalAlignment="Bottom"
                      Background="#5B6CE1"
                      Foreground="White"
                      BorderBrush="#5B6CE1"
                      BorderThickness="1"
                      FontSize="12"
                      FontWeight="SemiBold"
                      Cursor="Hand" />
            </Grid>
          </Grid>
        </Border>
        <TextBlock Grid.Row="4"
                   Text="YOUR LIMITS"
                   FontSize="10"
                   FontWeight="Bold"
                   Foreground="#8994A5" />
        <Grid Grid.Row="5" Margin="0,10,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="LimitItems" ItemTemplate="{StaticResource LimitItemTemplate}" />
          </ScrollViewer>
          <Border x:Name="EmptyText"
                  Padding="20"
                  CornerRadius="12"
                  Background="#FAFBFD"
                  BorderBrush="#EEF1F5"
                  BorderThickness="1"
                  VerticalAlignment="Top">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="No individual limits yet"
                         FontSize="13"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center" />
              <TextBlock Text="Add an app or website above to get started."
                         FontSize="11"
                         Foreground="#8994A5"
                         Margin="0,5,0,0"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
        <TextBlock Grid.Row="6"
                   Text="App closing is a graceful request; unsaved-work prompts may delay it."
                   FontSize="10"
                   Foreground="#8994A5"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel"
              Click="Cancel_Click"
              Margin="0,0,9,0"
              Background="White"
              Foreground="#657184"
              BorderBrush="#E1E6EF"
              Style="{StaticResource ActionButton}" />
      <Button x:Name="SaveLimitsButton"
              Content="Save limits"
              Click="SaveLimits_Click"
              Background="#5B6CE1"
              Foreground="White"
              BorderBrush="#5B6CE1"
              Style="{StaticResource ActionButton}" />
    </StackPanel>
    <Border x:Name="CooldownOverlay"
            Grid.Row="0"
            Grid.RowSpan="6"
            Panel.ZIndex="10"
            Background="#CCF4F6FA"
            Visibility="Collapsed">
      <Border Padding="26"
              CornerRadius="14"
              Background="White"
              BorderBrush="#E0E4FF"
              BorderThickness="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="Limit changes are locked"
                     FontSize="16"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
          <TextBlock x:Name="CooldownText"
                     FontSize="12"
                     Foreground="#657184"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     Margin="0,8,0,0" />
          <Button Content="Unlock limits now"
                  Click="UnlockLimits_Click"
                  Padding="16,8"
                  Margin="0,16,0,0"
                  HorizontalAlignment="Center"
                  Background="#F0F2FF"
                  Foreground="#5363D2"
                  BorderBrush="#E0E4FF"
                  FontWeight="SemiBold"
                  Cursor="Hand" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
